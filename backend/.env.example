# Copy to backend/.env for running the API, migrations and tests from your
# machine (outside Docker). Inside Docker, compose sets these from the root .env.
# Never commit the real .env.

# Postgres published by docker-compose.dev.yml on 127.0.0.1:5432
DATABASE_URL=postgres://questlog:change-me@localhost:5432/questlog
TEST_DATABASE_URL=postgres://questlog:change-me@localhost:5432/questlog_test

PORT=3000
LOG_LEVEL=info
APP_TIMEZONE=America/Mexico_City
# Freeze "now" to match the seeded data. Remove once real data is used (phase 3).
APP_NOW=2026-09-28T16:20:00-06:00
# Who /api/me returns until phase 2b adds login.
DEV_USER_EMAIL=gonzalo@questlog.dev
