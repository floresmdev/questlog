# Copy to `.env` (gitignored) at the repo root. Docker Compose reads it
# automatically for variable substitution. Never commit the real `.env`.

# Which compose files `docker compose` uses, so plain `docker compose up` = dev.
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# Database credentials. Use letters and digits only in the password: it is
# embedded in a connection URL.
POSTGRES_USER=questlog
POSTGRES_PASSWORD=change-me
POSTGRES_DB=questlog

# App settings (see backend/src/config.ts)
APP_TIMEZONE=America/Mexico_City
# Freezes "now" to match the seeded data. Remove in phase 3.
APP_NOW=2026-09-28T16:20:00-06:00
DEV_USER_EMAIL=gonzalo@questlog.dev
LOG_LEVEL=info
